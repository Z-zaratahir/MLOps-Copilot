# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- LLM providers ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- MLflow ---
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# --- Airflow 3 ---
AIRFLOW_BASE_URL=http://127.0.0.1:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=
AIRFLOW_APPROVED_DAG=parcel_delay_training

# --- Kubernetes ---
K8S_APPROVED_NAMESPACE=parcel-ml
K8S_APP_LABEL=app=parcel-delay-api

# --- Agent ---
AGENT_TOOL_TIMEOUT_SECONDS=15
MODEL_FRESHNESS_DAYS=14

# --- Docker compose paths (absolute) ---
PROJECT_DIR=/home/you/path/to/assignment-03-mlops-agent
A3_DIR=/home/you/path/to
